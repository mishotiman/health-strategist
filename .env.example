# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Database (matches docker-compose defaults; override in prod)
DATABASE_URL=postgresql://phs:phs@db:5432/phs

# Claude (generation)
ANTHROPIC_API_KEY=

# Voyage (primary embeddings: voyage-3, 1024 dims)
VOYAGE_API_KEY=

# OpenAI (fallback embeddings: text-embedding-3-large, request 1024 dims)
OPENAI_API_KEY=

# WHOOP OAuth2 — register the redirect URI in your WHOOP app
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/whoop/callback

# LangSmith (evals + agent tracing). If your workspace is in the EU region,
# also set LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
