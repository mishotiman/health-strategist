# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Database (matches docker-compose defaults; override in prod)
DATABASE_URL=postgresql://phs:phs@db:5432/phs

# Claude (generation)
ANTHROPIC_API_KEY=

# Voyage (primary embeddings: voyage-3.5, 512 dims)
VOYAGE_API_KEY=

# OpenAI (fallback embeddings: text-embedding-3-large, request 512 dims)
OPENAI_API_KEY=

# WHOOP OAuth2 — register the redirect URI in your WHOOP app
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/whoop/callback

# LangSmith (evals + agent tracing). If your workspace is in the EU region,
# also set LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=

# --- Model / cost controls (all optional; sensible defaults in code) ---
# RAG pipeline generator, used by /ask and the RAG eval. Default: claude-sonnet-5
RAG_GEN_MODEL=
# Override just the RAG eval's generator (defaults to RAG_GEN_MODEL).
EVAL_GEN_MODEL=
# The LangGraph agent's model, used by /chat and the agent eval.
# Default: claude-opus-4-8 (set claude-haiku-4-5 for cheap agent smoke runs).
AGENT_MODEL=
# Eval judge for both harnesses. Default: claude-haiku-4-5 (cheap + independent
# of both generators). Set claude-opus-4-8 for a stronger judge on a real baseline.
EVAL_JUDGE_MODEL=
# Set to a directory to cache LLM generations + judge verdicts across eval
# re-runs (keyed by request hash). Leave EMPTY in production.
LLM_CACHE_DIR=

# Rate limits on the endpoints that spend on the app's API keys (app/ratelimit.py).
# Requests allowed per window; windows are fixed in code (chat-user 5 min,
# chat-guest 15 min, ask 5 min, search 5 min). Defaults: 20 / 8 / 10 / 30.
RATE_CHAT_USER=
RATE_CHAT_GUEST=
RATE_ASK_IP=
RATE_SEARCH_IP=

# Embedding model + dimensions for BOTH the corpus (scripts/embed_chunks.py) and
# the query side (app/rag.py) — they MUST match. Defaults in code: voyage-3.5 @ 512.
EMBEDDING_MODEL=
EMBEDDING_DIM=
# HNSW recall knob (higher = better recall, slower). Optional; set once the ANN
# index exists (scripts/index_corpus.sql).
RAG_HNSW_EF_SEARCH=

# --- Accounts / auth ---
# Public origin of the app. Used for cookie hardening (Secure over https) and
# for the links inside verification / password-reset emails.
APP_BASE_URL=http://localhost:8000

# Google sign-in — create an OAuth client in Google Cloud Console and register
# <APP_BASE_URL>/auth/oauth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft sign-in — register an app in Azure AD ("Entra ID") and add
# <APP_BASE_URL>/auth/oauth/microsoft/callback as a redirect URI.
# Tenant "common" accepts both personal and work/school accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Resend — sends the email-verification and password-reset messages. With no key
# set, mail is skipped and the link is written to the logs instead, so the flow
# is still walkable locally. EMAIL_FROM must use a domain verified in Resend
# (their shared onboarding@resend.dev works for testing only).
RESEND_API_KEY=
EMAIL_FROM=Personal Health Strategist <onboarding@resend.dev>
